#!/usr/bin/env bash

# 1. Detect script folder
DEV_DIR="/catastrophic-dotfiles-installer/bin"
SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
if [[ "$SCRIPT_DIR" == *"$DEV_DIR"* ]]; then
    LIB_DIR="$HOME/Projects/catastrophic-dotfiles-installer/lib"
    echo
    echo ":: Running in dev environment"
else
    LIB_DIR="$HOME/.local/share/catastrophic-dotfiles-installer"
fi

# 2. Source Modules
source "$LIB_DIR/colors.sh"
source "$LIB_DIR/helpers.sh"
source "$LIB_DIR/utils.sh"

# Default settings
DOTFILES_DIR="$HOME/.mydotfiles"
TEST_MODE=false
VERBOSE=false
SCRIPT_VERSION="0.3.0"

# --- Check for Installer Config Folder ---
INSTALLER_CONFIG="$HOME/.config/catastrophic-dotfiles-installer"
if [ ! -d "$INSTALLER_CONFIG" ]; then
    mkdir -p "$INSTALLER_CONFIG"
fi

# 3. Global Cleanup Trap
cleanup() {
    stop_sudo_keepalive
    if [ -n "$CLONE_PATH" ] && [ -d "$CLONE_PATH" ]; then
        info "Cleaning up temporary files..."
        rm -rf "$CLONE_PATH"
    fi
}
trap cleanup EXIT

# 4. Help Function
show_help() {
    echo
    echo "------------------------"
    echo "Catastrophic Dotfiles Installer"
    echo "Version: $SCRIPT_VERSION"
    echo "------------------------"
    echo
    echo "Usage: catastrophic-dotfiles-installer [OPTIONS]"
    echo ""
    echo "Options: "
    echo "  --install <path/url> Install dotfiles from local path or URL"
    echo "  --target <path>      Target directory (Default: $HOME/.mydotfiles)"
    echo "  --testmode           Run setup logic only (No staging, No symlinks)"
    echo "  --verbose            Show package installation output (always logged)"
    echo "  --help               Show this help message"
}

# 5. Argument Parsing
if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

while [[ $# -gt 0 ]]; do
    case $1 in
        --install)
            INSTALL_URL="$2"
            if [[ ! "$INSTALL_URL" =~ ^https?:// ]] && [ -f "$INSTALL_URL" ]; then
                INSTALL_URL=$(realpath "$INSTALL_URL")
            fi
            shift 2 ;;
        --target)
            DOTFILES_DIR="$(mkdir -p "$2" && cd "$2" && pwd)"
            shift 2 ;;
        --testmode)
            TEST_MODE=true
            shift ;;
        --verbose)
            VERBOSE=true
            shift ;;
        --help)
            show_help
            exit 0 ;;
        *)
            error "Unknown option: $1"
            show_help
            exit 1 ;;
    esac
done

clear
echo
info "Running Catastrophic Dotfiles Installer ($SCRIPT_VERSION)..."

# 6. Execute Logic
[ -z "$INSTALL_URL" ] && { show_help; exit 0; }

init_log
info "Logfile: $LOG_FILE"

# Step A: Check dependencies for running the script
check_dependencies

# Step B: Read configuration and prepare environment
RESULT=$(read_dotinst "$INSTALL_URL" "$DOTFILES_DIR" "$TEST_MODE")

# Catch cases where the subshell exited early or cancelled
[ -z "$RESULT" ] && exit 0

CLONE_PATH=$(echo "$RESULT" | awk '{print $1}')
PROFILE_ID=$(echo "$RESULT" | awk '{print $2}')
SUBFOLDER=$(echo "$RESULT" | awk '{print $3}')

if [ -n "$CLONE_PATH" ] && [ -d "$CLONE_PATH" ]; then
    PROFILE_CONFIG="$INSTALLER_CONFIG/$PROFILE_ID"
    mkdir -p "$PROFILE_CONFIG"

    FINAL_TARGET="$DOTFILES_DIR/$PROFILE_ID"

    # A fresh install may fill in machine-specific defaults (such as the keyboard layout);
    # an update must never change what is already set up
    FRESH_INSTALL=1
    [ -d "$FINAL_TARGET" ] && FRESH_INSTALL=0

    # --- Step B.5: Update-specific Logic (Backup & Restore) ---
    if [ -d "$FINAL_TARGET" ] && [ "$TEST_MODE" = false ]; then
        backup_existing_profile "$FINAL_TARGET" "$PROFILE_ID" "$DOTFILES_DIR" || {
            error "Your current setup could not be backed up, so the update was stopped before anything changed."
            exit 1
        }

        DOTINST_JSON=$(get_json_content "$INSTALL_URL")
        RESTORE_COUNT=$(echo "$DOTINST_JSON" | jq '.restore | length' 2>/dev/null)
        
        if [ "$RESTORE_COUNT" != "null" ] && [ "$RESTORE_COUNT" -gt 0 ]; then
            handle_restore_logic "$DOTINST_JSON" "$FINAL_TARGET" "$CLONE_PATH" "$SUBFOLDER"
        fi
    fi

    info "Repository prepared. Starting package setup..."
    run_setup_logic "$CLONE_PATH" "$PROFILE_ID"
    
    # --- Step C: Test Mode Exit ---
    if [ "$TEST_MODE" = true ]; then
        warn "Test Mode active: Skipping file staging and symlink creation."
        info "Setup logic completed successfully."
        info "Logfile: $LOG_FILE"
        exit 0
    fi

    # Step D: Deploy staged dotfiles
    BLACKLIST_FILE="$PROFILE_CONFIG/blacklist"

    if [ -n "$SUBFOLDER" ] && [ "$SUBFOLDER" != "null" ]; then
        SRC_DIR="$CLONE_PATH/$SUBFOLDER"
    else
        SRC_DIR="$CLONE_PATH"
    fi

    if [ -d "$SRC_DIR" ]; then
        # Update: drop what the repo no longer ships before staging the new files
        MANIFEST_FILE="$PROFILE_CONFIG/manifest"
        info "Checking for obsolete files..."
        # The settings kept from the old install (restore) can bring back files the repo dropped
        remove_obsolete_paths "$SRC_DIR" "$CLONE_PATH/setup/obsolete-paths"
        prune_obsolete "$SRC_DIR" "$FINAL_TARGET" "$CLONE_PATH" "$MANIFEST_FILE"

        if copy_with_blacklist "$SRC_DIR" "$FINAL_TARGET" "$BLACKLIST_FILE" "$MANIFEST_FILE"; then
            info "Successfully updated $PROFILE_ID dotfiles in sandbox."
            
            # Step E: Create symlinks
            deploy_symlinks "$FINAL_TARGET" "$DOTFILES_DIR" "$PROFILE_ID" "$BLACKLIST_FILE"
            remove_dangling_links "$FINAL_TARGET"
            write_manifest "$SRC_DIR" "$MANIFEST_FILE"

            # Step F: Set active profile
            set_active_profile "$PROFILE_ID"

            # Step G: Run migration script
            run_migration "$CLONE_PATH" "$PROFILE_ID"

            echo
            echo "---------------------------------------------------"
            info "Installation successful! Please reboot your system."
            info "You can find the logfile at: $LOG_FILE"
            echo "---------------------------------------------------"
        else
            echo
            echo "----------------------------------------"
            error "Failed to deploy dotfiles. Your previous setup is backed up in $DOTFILES_DIR/backups/."
            info "You can find the logfile at: $LOG_FILE"
            echo "----------------------------------------"
            exit 1
        fi
    else
        error "Source folder '$SRC_DIR' not found in cloned repository."
        exit 1
    fi
else
    error "Installation failed: Repository environment could not be initialized."
    exit 1
fi
