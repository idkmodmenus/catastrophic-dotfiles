#!/usr/bin/env bash

set -euo pipefail

DOCK_DIR="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")"

IPC_FUNCTIONS=(
    toggle enable disable
    autohideToggle autohideOn autohideOff
    reload settings edit
)

usage() {
    cat <<USAGE
Usage: catastrophic-dock [command]

Commands:
  start             Start the dock (default, does nothing if it is already running)
  stop              Stop the dock
  restart           Stop and start the dock
  toggle            Show or hide the dock
  enable            Show the dock
  disable           Hide the dock
  autohideToggle    Toggle autohide
  autohideOn        Turn autohide on
  autohideOff       Turn autohide off
  reload            Re-read config.json and apply it
  settings          Open the settings dialog
  edit              Open config.json in the configured editor
  help              Show this help
USAGE
}

if ! command -v qs >/dev/null 2>&1; then
    echo ":: ERROR: quickshell (qs) is required but not installed." >&2
    exit 1
fi

command="${1:-start}"

case "$command" in
    start)
        exec qs -n -p "$DOCK_DIR"
        ;;
    stop)
        qs kill -p "$DOCK_DIR"
        ;;
    restart)
        qs kill -p "$DOCK_DIR" >/dev/null 2>&1 || true
        exec qs -n -p "$DOCK_DIR"
        ;;
    help | -h | --help)
        usage
        ;;
    *)
        for fn in "${IPC_FUNCTIONS[@]}"; do
            if [ "$command" = "$fn" ]; then
                running() { qs -p "$DOCK_DIR" ipc show >/dev/null 2>&1; }
                if ! running; then
                    setsid -f qs -n -p "$DOCK_DIR" >/dev/null 2>&1 </dev/null
                    for _ in $(seq 1 50); do running && break; sleep 0.1; done
                fi
                config="$HOME/.config/catastrophic-dock/config.json"
                is_on() { grep -q '"enabled"[[:space:]]*:[[:space:]]*true' "$config" 2>/dev/null; }
                turning_off=0
                if [ "$command" = "disable" ] || { [ "$command" = "toggle" ] && is_on; }; then
                    turning_off=1
                fi
                qs -p "$DOCK_DIR" ipc call dock "$command"
                if [ "$turning_off" = 1 ]; then
                    for _ in $(seq 1 30); do
                        is_on || break
                        sleep 0.1
                    done
                    qs kill -p "$DOCK_DIR" >/dev/null 2>&1 || true
                fi
                exit 0
            fi
        done
        echo ":: ERROR: Unknown command: $command" >&2
        usage >&2
        exit 1
        ;;
esac
