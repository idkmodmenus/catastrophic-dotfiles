* {
    background: rgba(37, 47, 77, 0.7);
    primary: #a2c9ff;
    primary-fixed: #d3e4ff;
    primary-fixed-dim: #a2c9ff;
    on-primary: #00315b;
    on-primary-fixed: #001c38;
    on-primary-fixed-variant: #004881;
    primary-container: #004881;
    on-primary-container: #d3e4ff;
    secondary: #bbc5ea;
    secondary-fixed: #dbe1ff;
    secondary-fixed-dim: #bbc5ea;
    on-secondary: #252f4d;
    on-secondary-fixed: #0f1a37;
    on-secondary-fixed-variant: #3c4665;
    secondary-container: #3c4665;
    on-secondary-container: #dbe1ff;
    tertiary: #c3c1f9;
    tertiary-fixed: #e2dfff;
    tertiary-fixed-dim: #c3c1f9;
    on-tertiary: #2c2b59;
    on-tertiary-fixed: #161543;
    on-tertiary-fixed-variant: #424271;
    tertiary-container: #424271;
    on-tertiary-container: #e2dfff;
    error: #ffb4ab;
    on-error: #690005;
    error-container: #93000a;
    on-error-container: #ffdad6;
    surface: #0e141c;
    on-surface: #dde3ee;
    on-surface-variant: #c1c7d2;
    outline: #8b919c;
    outline-variant: #414750;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #dde3ee;
    inverse-on-surface: #2b313a;
    inverse-primary: #0060a9;
    surface-dim: #0e141c;
    surface-bright: #343a43;
    surface-container-lowest: #090f16;
    surface-container-low: #161c24;
    surface-container: #1a2028;
    surface-container-high: #252a33;
    surface-container-highest: #2f353e;
