finder() {
    local result=$($HOME/.config/catastrophic/bin/catastrophic-finder)

    if [[ "$result" == TYPE_DIR:* ]]; then
        local target_dir="${result#TYPE_DIR:}"
        cd "$target_dir" && ls
    elif [[ "$result" == TYPE_FILE:* ]]; then
        ${EDITOR:-nano} "${result#TYPE_FILE:}"
    else
        echo "Could not read $result" >&2
        return 1
    fi
}

if [[ $(tty) == *"pts"* ]]; then
    if [ ! -f $HOME/.config/catastrophic/settings/hide-fastfetch ]; then
        fastfetch
    fi
fi
