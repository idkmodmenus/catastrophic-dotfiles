
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "arch",
    "color": {
      "1": "#1793D1",
      "2": "#FFFFFF"
    },
    "padding": {
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#1793D1",
      "output": "#FFFFFF"
    },
    "key": {
      "width": 12
    }
  },
  "modules": [
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "#1793D1"
    },
    {
      "type": "command",
      "key": "KITTY",
      "keyColor": "#C084FC",
      "text": "kitty --version | head -n 1"
    },
    {
      "type": "command",
      "key": "HYPRLAND",
      "keyColor": "#1793D1",
      "text": "hyprctl version | head -n 1"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#C084FC",
      "format": "{name}"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#1793D1",
      "format": "{name}"
    }
  ]
}
