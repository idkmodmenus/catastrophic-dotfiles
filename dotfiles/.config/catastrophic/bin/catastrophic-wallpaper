#!/bin/bash

SEARCH_PATH="$HOME/Pictures/wallpapers"

if [ -f ~/.config/catastrophic/settings/wallpaper-folder ]; then
    SEARCH_PATH=$(cat ~/.config/catastrophic/settings/wallpaper-folder)
fi
eval SEARCH_PATH="$SEARCH_PATH"
SEARCH_PATH="$(realpath "$SEARCH_PATH")" 

LIST=$(find "$SEARCH_PATH" -maxdepth 5 -type f \( \
    -iname "*.jpg" -o \
    -iname "*.jpeg" -o \
    -iname "*.png" -o \
    -iname "*.webp" -o \
    -iname "*.gif" \
\) 2>/dev/null)

if [ -z "$LIST" ]; then
    if [ ! -d "$SEARCH_PATH" ]; then
        echo "❌ Error: Directory '$SEARCH_PATH' not found. Please create it."
        echo ":: You can define your own Wallpaper folder in ~/.config/catastrophic/settings/wallpaper-folder"
    else
        echo "❌ Error: No images (jpg/png/webp/gif) found in $SEARCH_PATH."
        echo ":: You can define your own Wallpaper folder in ~/.config/catastrophic/settings/wallpaper-folder"
    fi
    exit 1
fi

SELECTED=$(echo "$LIST" | fzf \
    --style full \
    --height 70% \
    --layout reverse \
    --border \
    --prompt "🖼️ Select Image: " \
    --header "ENTER to set wallpaper with waypaper" \
    --preview-window right:50%:wrap
    )
if [ -n "$SELECTED" ]; then
    printf '{"action": "remove", "identifier": "fzf_preview"}\n' > /tmp/fzf-ueberzug.pipe 2>/dev/null
    
    "$HOME/.config/catastrophic/scripts/catastrophic-wallpaper" "$SELECTED" >/dev/null 2>&1 &
    exit 0
fi