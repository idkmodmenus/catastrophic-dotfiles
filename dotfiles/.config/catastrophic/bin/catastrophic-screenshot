#!/usr/bin/env bash

SAVE_DIR="$HOME/Pictures"
SAVE_FILENAME="screenshot_$(date +%d%m%Y_%H%M%S).jpg"

if [ -f ~/.config/catastrophic/settings/screenshot-folder ]; then
    SAVE_DIR=$(cat ~/.config/catastrophic/settings/screenshot-folder)
fi
if [ -f ~/.config/catastrophic/settings/screenshot-filename ]; then
    SAVE_FILENAME=$(cat ~/.config/catastrophic/settings/screenshot-filename)
fi

eval screenshot_folder="$SAVE_DIR"
eval filename="$SAVE_FILENAME"
path="$screenshot_folder/$filename"

image_format="png"
extension="${filename##*.}"

case $extension in
    "jpg"|"jpeg")
        image_format="jpeg"
        ;;
    "ppm")
        image_format="ppm"
        ;;
esac

mkdir -p "$SAVE_DIR"

take_screenshot() {
    local mode=$1
    local delay=$2
    if [ "$delay" -gt 0 ]; then
        echo "⏱️ Waiting $delay seconds..."
        sleep "$delay"
    fi

    echo "📸 Capturing $mode..."

    case $mode in
        "fullscreen")
            grim -t "$image_format" "$path"
            ;;
        "area")
            GEOM=$(slurp)
            [ -z "$GEOM" ] && exit 0
            grim -g "$GEOM" -t "$image_format" "$path"
            ;;
        "window")
            GEOM=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
            grim -g "$GEOM" -t "$image_format" "$path"
            ;;
    esac

    if [ -f "$path" ]; then
        wl-copy < "$path"
        echo "---------------------------------------"
        echo "✅ Success!"
        echo "📂 Saved: $path"
        echo "📋 Copied to clipboard."
        echo "---------------------------------------"
        sleep 1
    else
        echo "❌ Error: Screenshot failed."
    fi
}

if [ "$#" -ge 1 ]; then
    take_screenshot "$1" "${2:-0}"
    exit 0
fi

MODE_CHOICE=$(echo -e "area\nwindow\nfullscreen" | fzf \
    --style full \
    --height 15% \
    --layout reverse \
    --border \
    --prompt "🎯 Select Screenshot Mode: " \
    --header "ESC to cancel")

[ -z "$MODE_CHOICE" ] && exit 0

DELAY_CHOICE=$(echo -e "0s\n2s\n5s\n10s" | fzf \
    --style full \
    --height 15% \
    --layout reverse \
    --border \
    --prompt "⏳ Set Delay: " \
    --header "Time before capture")

[ -z "$DELAY_CHOICE" ] && exit 0

CLEAN_DELAY=$(echo "$DELAY_CHOICE" | sed 's/s//')

take_screenshot "$MODE_CHOICE" "$CLEAN_DELAY"
