#!/usr/bin/env bash

_checkCommandExists() {
    command -v "$1" &> /dev/null
}

_isInstalled() {
    package="$1"
    case $install_platform in
        arch)
            check="$($aur_helper -Qs --color always "${package}" | grep "local" | grep "${package} ")"
            ;;
        fedora)
            check="$(dnf repoquery --quiet --installed ""${package}*"")"
            ;;
        *) ;;
    esac

    if [ -n "${check}" ]; then
        echo 0
        return
    fi
    echo 1
    return
}

sleep 1
clear
figlet -f smslant "Updates"
echo
primarycolor=$(cat ~/.config/catastrophic/colors/primary)
onsurfacecolor=$(cat ~/.config/catastrophic/colors/onsurface)
onprimarycolor=$(cat ~/.config/catastrophic/colors/onprimary)
if gum confirm --selected.background=$primarycolor --selected.foreground=$onprimarycolor --prompt.foreground=$onsurfacecolor "DO YOU WANT TO START THE UPDATE NOW?"; then
    echo
    echo ":: Update started..."
elif [ $? -eq 130 ]; then
    exit 130
else
    echo
    echo ":: Update canceled."
    exit
fi

if _checkCommandExists "pacman"; then

    yay_installed="false"
    paru_installed="false"
    if _checkCommandExists "yay"; then
        yay_installed="true"
    fi
    if _checkCommandExists "paru"; then
        paru_installed="true"
    fi
    if [[ $yay_installed == "true" ]] && [[ $paru_installed == "false" ]]; then
        yay
    elif [[ $yay_installed == "false" ]] && [[ $paru_installed == "true" ]]; then
        paru -Syu
    else
        sudo pacman -Syu
    fi

elif _checkCommandExists "dnf"; then
    sudo dnf upgrade
elif _checkCommandExists "zypper"; then
    sudo zypper dup
elif _checkCommandExists "apt"; then
    sudo apt update && sudo apt upgrade
else
    echo ":: ERROR - Platform not supported"
    echo "Press [ENTER] to close."
    read
fi
echo

if _checkCommandExists "flatpak"; then
    echo ":: Searching for Flatpak updates..."
    flatpak update
    echo
fi

qs ipc call updates refresh

echo ":: Update complete! Press [ENTER] to close."
read
