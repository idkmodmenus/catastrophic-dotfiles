#!/usr/bin/env bash

catastrophic_cache_folder="$HOME/.cache/catastrophic/hyprland-dotfiles"

source "$HOME/.config/catastrophic/scripts/catastrophic-notification-handler"
APP_NAME="Waypaper"
NOTIFICATION_ICON="preferences-desktop-wallpaper-symbolic"

sec=$(cat ~/.config/catastrophic/settings/wallpaper-automation)
_setWallpaperRandomly() {
    while true; do
        $HOME/.config/catastrophic/scripts/catastrophic-wallpaper --random
        echo ":: Next wallpaper in $sec seconds..."
        sleep $sec
    done
}

if [ ! -f $catastrophic_cache_folder/wallpaper-automation ]; then
    touch $catastrophic_cache_folder/wallpaper-automation
    echo ":: Start wallpaper automation script"
    notify_user \
        --a "${APP_NAME}" \
        --i "${NOTIFICATION_ICON}" \
        --m "Wallpaper automation process started.\nWallpaper will be changed every $sec seconds."
    _setWallpaperRandomly
else
    rm $catastrophic_cache_folder/wallpaper-automation
    notify_user \
        --a "${APP_NAME}" \
        --i "${NOTIFICATION_ICON}" \
        --m "Wallpaper automation process stopped."
    echo ":: Wallpaper automation script process $wp stopped"
    wp=$(pgrep -f catastrophic-wallpaper-automation)
    kill -KILL $wp
fi
