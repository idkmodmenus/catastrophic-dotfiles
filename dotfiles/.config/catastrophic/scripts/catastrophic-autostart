#!/usr/bin/env bash

CACHE_FOLDER="$HOME/.cache/catastrophic/hyprland-dotfiles"
CACHE_FILE="$CACHE_FOLDER/current_wallpaper"
DEFAULT_WALLPAPER="$HOME/.config/catastrophic/wallpapers/default.jpg"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1" >&2; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

mkdir -p $HOME/.cache

mkdir -p "$CACHE_FOLDER"
if [ ! -s "$CACHE_FILE" ]; then
    echo "$DEFAULT_WALLPAPER" > "$CACHE_FILE"
    info "Cache file created"
fi

nm-applet --indicator &

if [ -z "$QS_ICON_THEME" ]; then
    GTK_SETTINGS="$HOME/.config/gtk-3.0/settings.ini"
    if [ -f "$GTK_SETTINGS" ]; then
        ICON_THEME="$(grep 'gtk-icon-theme-name' "$GTK_SETTINGS" | sed 's/.*\s*=\s*//')"
        [ -n "$ICON_THEME" ] && export QS_ICON_THEME="$ICON_THEME"
    fi
fi
info "Quickshell icon theme: ${QS_ICON_THEME:-<unset>}"

mkdir -p "$HOME/.local/state/catastrophic"
[ -e "$HOME/.local/state/catastrophic/update-status" ] || echo ok > "$HOME/.local/state/catastrophic/update-status"

killall qs 2>/dev/null || true

info "Starting Quickshell"
qs &

info "Waiting for Quickshell..."
timeout=15
elapsed=0
until pgrep -x qs >/dev/null 2>&1; do
    sleep 0.2
    elapsed=$((elapsed + 1))
    if [ $elapsed -ge $((timeout * 5)) ]; then
        warn "Quickshell did not start within ${timeout}s"
        break
    fi
done
sleep 0.5
info "Quickshell ready"

WALLPAPER="$(cat "$CACHE_FILE" 2>/dev/null)"
if [ ! -f "$WALLPAPER" ]; then
    warn "Saved wallpaper not found: ${WALLPAPER:-<empty>}"
    WALLPAPER="$DEFAULT_WALLPAPER"
    if [ ! -f "$WALLPAPER" ]; then
        WALLPAPER="$(find "$HOME/.config/catastrophic/wallpapers" -maxdepth 1 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) 2>/dev/null | sort | head -n 1)"
    fi
    echo "$WALLPAPER" > "$CACHE_FILE"
    info "Using $WALLPAPER instead"
fi

if awww query 2>/dev/null | grep -qF -- "$(realpath -- "$WALLPAPER")"; then
    info "awww is already showing the wallpaper, applying theming only for $WALLPAPER"
    ~/.config/catastrophic/scripts/catastrophic-wallpaper "$WALLPAPER" --skip-wallpaper &
else
    info "Set wallpaper to $WALLPAPER"
    ~/.config/catastrophic/scripts/catastrophic-wallpaper "$WALLPAPER" &
fi

if grep -q '"enabled"[[:space:]]*:[[:space:]]*true' ~/.config/catastrophic-dock/config.json 2>/dev/null; then
    info "Starting Catastrophic Dock"
    catastrophic-dock start &
fi

info "Starting update check"
~/.config/catastrophic/scripts/catastrophic-update-check &

info "Starting Catastrophic Welcome App"
if [ ! -f $HOME/.cache/catastrophic-welcome-autostart ]; then
    timeout=30
    count=0
    sleep 1
    until qs ipc call welcome toggle >/dev/null 2>&1; do
        (( count++ ))
        if (( count >= timeout )); then
            warn "Welcome IPC not available after ${timeout}s"
            break
        fi
        sleep 1
    done
    info "Catastrophic Welcome started"
else
    info "Catastrophic Welcome disabled"
fi
