#!/usr/bin/env bash
WALLPAPER_APP="quickshell"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

mkdir -p $HOME/.cache

info() { echo -e "${GREEN}[INFO]${NC} $1" >&2; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1" >&2; }
error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

if [ -f $HOME/.config/catastrophic/settings/wallpaper-app ]; then
    WALLPAPER_APP=$(cat $HOME/.config/catastrophic/settings/wallpaper-app)
fi

if [ -f $HOME/.config/catastrophic/settings/wallpaper-folder ]; then
    RAW_FOLDER=$(cat $HOME/.config/catastrophic/settings/wallpaper-folder)
    WALLPAPER_FOLDER="${RAW_FOLDER//\$HOME/$HOME}"
    WALLPAPER_FOLDER="${WALLPAPER_FOLDER//\~/$HOME}"    
fi

if [ "$1" == "--restore" ]; then
    if [ "$WALLPAPER_APP" == "waypaper" ]; then
        waypaper --restore
    else
        error "Wallpaper App $WALLPAPER_APP not supported."
    fi    
    exit
elif [ "$1" == "--random" ]; then
    if [ "$WALLPAPER_APP" == "quickshell" ]; then
        $HOME/.config/catastrophic/scripts/catastrophic-wallpaper --random
    elif [ "$WALLPAPER_APP" == "waypaper" ]; then
        waypaper --random --folder "$WALLPAPER_FOLDER"
    else
        error "Wallpaper App $WALLPAPER_APP not supported."
    fi    
    exit
fi

if [ "$WALLPAPER_APP" == "quickshell" ]; then
    info "Toggle Quickshell Wallpaper App"
    qs ipc call wallpaper toggle
elif [ "$WALLPAPER_APP" == "waypaper" ]; then
    info "Launch Waypaper"
    waypaper --folder "$WALLPAPER_FOLDER"
else
    error "Wallpaper App $WALLPAPER_APP not supported."
fi