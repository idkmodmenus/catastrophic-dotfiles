#!/usr/bin/env bash

source "$HOME/.config/catastrophic/scripts/catastrophic-notification-handler"
APP_NAME="Waypaper"
NOTIFICATION_ICON="preferences-desktop-wallpaper-symbolic"

catastrophic_cache_folder="$HOME/.cache/catastrophic/hyprland-dotfiles"

cache_file="$catastrophic_cache_folder/current_wallpaper"

options="$(ls ~/.config/hypr/effects/wallpaper/)\noff"

choice=$(echo -e "$options" | $HOME/.config/catastrophic/scripts/catastrophic-launcher dmenu -p "Wallpaper effect" -l 5 --rofi-args "-no-show-icons -width 30")
if [ ! -z $choice ]; then
    echo "$choice" > "$HOME/.config/catastrophic/settings/wallpaper-effect"
    $HOME/.config/catastrophic/scripts/catastrophic-wallpaper "$(cat $cache_file)"
fi
