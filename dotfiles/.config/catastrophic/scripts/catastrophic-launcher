#!/usr/bin/env bash

_resolve_launcher() {
    local launcher=""
    local settings_file="$HOME/.config/catastrophic/settings/launcher"
    if [ -f "$settings_file" ]; then
        launcher=$(tr -d '[:space:]' <"$settings_file")
    fi
    if [ "$launcher" == "walker" ] && command -v walker >/dev/null 2>&1; then
        echo "walker"
    else
        echo "rofi"
    fi
}

launcher=$(_resolve_launcher)

_ensure_elephant() {
    pgrep -x elephant >/dev/null 2>&1 && return 0
    command -v elephant >/dev/null 2>&1 || return 1
    local sock="${XDG_RUNTIME_DIR:-/tmp}/elephant/elephant.sock" i
    setsid -f elephant >/dev/null 2>&1 </dev/null
    for i in $(seq 1 50); do
        [ -S "$sock" ] && pgrep -x elephant >/dev/null 2>&1 && return 0
        sleep 0.1
    done
    return 1
}

_drun() {
    if qs ipc call launcher toggle >/dev/null 2>&1; then
        return
    fi
    if [ "$launcher" == "walker" ]; then
        _ensure_elephant
        walker -t catastrophic --height 500
    else
        pkill rofi || rofi -show drun -replace -i
    fi
}

_dmenu() {
    local prompt=""
    local config="$HOME/.config/rofi/config-themes.rasi"
    local lines=""
    local index=0
    local rofi_extra=()
    local walker_extra=()

    while [ $# -gt 0 ]; do
        case "$1" in
            -p) prompt="$2"; shift 2 ;;
            -c) config="$2"; shift 2 ;;
            -l) lines="$2"; shift 2 ;;
            --index) index=1; shift ;;
            --rofi-args) read -ra rofi_extra <<<"$2"; shift 2 ;;
            --walker-args) read -ra walker_extra <<<"$2"; shift 2 ;;
            *) echo "catastrophic-launcher: unknown option $1" >&2; exit 1 ;;
        esac
    done

    if [ "$launcher" == "walker" ]; then
        _ensure_elephant
        local args=(-t catastrophic -d -N -H)
        [ -n "$prompt" ] && args+=(-p "$prompt")
        [ "$index" == 1 ] && args+=(-i)
        walker "${args[@]}" "${walker_extra[@]}"
    else
        local args=(-dmenu -replace -i -config "$config")
        [ -n "$prompt" ] && args+=(-p "$prompt")
        [ -n "$lines" ] && args+=(-l "$lines")
        [ "$index" == 1 ] && args+=(-format i)
        rofi "${args[@]}" "${rofi_extra[@]}"
    fi
}

case "$1" in
    "" | drun) _drun ;;
    dmenu) shift; _dmenu "$@" ;;
    which) echo "$launcher" ;;
    ensure) [ "$launcher" == "walker" ] && _ensure_elephant ;;
    *) echo "catastrophic-launcher: unknown command $1" >&2; exit 1 ;;
esac
