#!/bin/bash

class="catastrophic-dropdown"

if ! hyprctl clients -j | jq -e --arg c "$class" '.[] | select(.class == $c)' > /dev/null; then
    kitty -1 --instance-group catastrophic --class "$class" > /dev/null 2>&1 &
    disown
fi

hyprctl dispatch 'hl.dsp.workspace.toggle_special("dropdown")' > /dev/null
