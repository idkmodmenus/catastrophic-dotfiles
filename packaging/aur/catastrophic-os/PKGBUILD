# Maintainer: idkmodmenus <https://github.com/idkmodmenus>
#
# Installs the Catastrophic OS installer and its files to /usr/share/catastrophic-os.
# Nothing is written to your home folder by the package itself: run `catastrophic-os`
# afterwards to set up the desktop (it asks before every system-level change).

pkgname=catastrophic-os
pkgver=2.22.0
pkgrel=1
pkgdesc="Hyprland desktop for Arch and CachyOS with a glass island bar, hover popouts and wallpaper colours"
arch=('any')
url="https://github.com/idkmodmenus/catastrophic-dotfiles"
license=('MIT')
depends=('bash' 'curl' 'sudo' 'git')
provides=('catastrophic-os')
conflicts=('catastrophic-os-git')
install="$pkgname.install"
options=('!strip' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP_UNTIL_RELEASED')

package() {
    local src="$srcdir/catastrophic-dotfiles-$pkgver"
    install -d "$pkgdir/usr/share/$pkgname"
    cp -a --no-preserve=ownership "$src/." "$pkgdir/usr/share/$pkgname/"
    rm -rf "$pkgdir/usr/share/$pkgname/packaging" "$pkgdir/usr/share/$pkgname/.git"

    install -Dm755 /dev/stdin "$pkgdir/usr/bin/catastrophic-os" <<'WRAPPER'
#!/usr/bin/env bash
# Sets up (or updates) Catastrophic OS for the current user from the files this
# package installed. The installer works on a copy, so /usr/share stays untouched.
if [ "$(id -u)" -eq 0 ]; then
    echo ":: Run catastrophic-os as your normal user, not as root." >&2
    exit 1
fi
exec bash /usr/share/catastrophic-os/install.sh "$@"
WRAPPER

    install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
    [ -f "$src/LICENSE" ] && install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    return 0
}
