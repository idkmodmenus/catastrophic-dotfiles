    "subfolder": "dotfiles",
    "restore": [
        {
            "title": "Keep my Catastrophic settings",
            "source": ".config/catastrophic/settings"
        },
        {
            "title": "Keep my monitor layout",
            "source": ".config/hypr/monitors.lua"
        },
        {
            "title": "Keep my keyboard and mouse settings",
            "source": ".config/hypr/input.lua"
        }
    ]
}
